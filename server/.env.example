DATABASE_URL="file:./dev.db?connection_limit=1"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1h"
PORT=4000
# Çalışma aktivitesinde gün sınırı için saat dilimi
ACTIVITY_TIMEZONE="Europe/Istanbul"

# Web uygulamasının adresi (PayTR dönüş sayfaları ve şifre sıfırlama bağlantıları için)
WEB_BASE_URL="http://localhost:5173"
# Tünel / ters vekil arkasında gerçek istemci IP'si için 1 yapın (PayTR user_ip ister)
TRUST_PROXY=0

# PayTR iFrame API — mağaza paneli > Bilgi sayfasından. Boş bırakılırsa ücretli kurs ödemesi kapalıdır.
# Bildirim URL'si panelde şu adres olarak tanımlanmalıdır: https://<api-adresi>/api/v1/payments/paytr/callback
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# 1 = test işlemi (canlı mağazada test ödemesi), 0 = gerçek ödeme
PAYTR_TEST_MODE=1
